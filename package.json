{
	"name": "educa-angular",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng serve --port=4201",
		"build": "node --max_old_space_size=16384 ./node_modules/@angular/cli/bin/ng build --stats-json",
		"postbuild": "node scripts/make-loader.js",
		"watch": "ng build --watch --configuration development",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"e2e": "playwright test",
		"bundle-report": "node --max_old_space_size=16384 ./node_modules/@angular/cli/bin/ng build --stats-json && node scripts/bundle-report.mjs",
		"bundle-check": "node --max_old_space_size=16384 ./node_modules/@angular/cli/bin/ng build --stats-json && node scripts/bundle-report.mjs --check",
		"lint": "ng lint",
		"lint:fix": "ng lint --fix",
		"compodoc": "node -e \"fs.rmSync('documentation', { recursive: true, force: true })\" && compodoc -p tsconfig.doc.json -s -w -o --port 8080",
		"start:prod": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng serve --configuration production --port=4202",
		"convert-images": "node scripts/convert-images.mjs",
		"serve:ssr:educa-angular": "node dist/educa-angular/server/server.mjs",
		"audit:deps": "node scripts/audit-deps.mjs",
		"audit:deps:ci": "node scripts/audit-deps.mjs --ci",
		"gen:caps": "node scripts/gen-capability-codes.mjs",
		"build:cap": "node --max_old_space_size=16384 ./node_modules/@angular/cli/bin/ng build --configuration capacitor",
		"cap:sync": "npx cap sync",
		"cap:android": "npm run build:cap && npx cap sync android && npx cap open android",
		"cap:ios": "npm run build:cap && npx cap sync ios && npx cap open ios"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"sideEffects": false,
	"packageManager": "npm@11.6.2",
	"dependencies": {
		"@angular/animations": "^22.1.3",
		"@angular/cdk": "^22.1.4",
		"@angular/common": "^22.1.3",
		"@angular/compiler": "^22.1.3",
		"@angular/core": "^22.1.3",
		"@angular/forms": "^22.1.3",
		"@angular/platform-browser": "^22.1.3",
		"@angular/platform-browser-dynamic": "^22.1.3",
		"@angular/platform-server": "^22.1.3",
		"@angular/router": "22.1.3",
		"@angular/service-worker": "^22.1.3",
		"@angular/ssr": "^22.1.6",
		"@capacitor/android": "^8.3.0",
		"@capacitor/camera": "^8.0.2",
		"@capacitor/cli": "^7.6.1",
		"@capacitor/core": "^8.3.0",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/ios": "^8.3.0",
		"@capacitor/local-notifications": "^8.0.2",
		"@capacitor/push-notifications": "^8.0.3",
		"@capacitor/splash-screen": "^8.0.1",
		"@capacitor/status-bar": "^8.0.2",
		"@microsoft/signalr": "^10.0.0",
		"@ngrx/operators": "^22.0.0",
		"@ngrx/signals": "^22.0.0",
		"@types/three": "^0.183.1",
		"bootstrap-icons": "^1.13.1",
		"chart.js": "^4.5.1",
		"exceljs": "^4.4.0",
		"express": "^5.1.0",
		"primeicons": "^7.0.0",
		"rxjs": "~7.8.0",
		"three": "^0.183.2",
		"tslib": "^2.3.0",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "^2.7.0",
		"@analogjs/vitest-angular": "^2.7.0",
		"@angular-eslint/builder": "^22.1.0",
		"@angular/build": "^22.1.6",
		"@angular/cli": "^22.1.6",
		"@angular/compiler-cli": "^22.1.3",
		"@compodoc/compodoc": "^1.1.25",
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.61.1",
		"@types/express": "^5.0.1",
		"@types/node": "^20.17.19",
		"@vitest/coverage-v8": "^4.0.17",
		"angular-eslint": "^22.1.0",
		"esbuild-visualizer": "^0.7.0",
		"eslint": "^9.28.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.8.0",
		"sharp": "^0.34.5",
		"source-map-explorer": "^2.5.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.33.1",
		"vite": "^6.0.0",
		"vitest": "^4.0.0"
	}
}
